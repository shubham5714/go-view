# port
VITE_DEV_PORT = '3001'

# development path (Spring Boot API)
VITE_DEV_PATH = 'http://127.0.0.1:8083'

# production path
VITE_PRO_PATH = 'http://127.0.0.1:8083'

# Auth: sso = redirect to AI-SOC when unauthenticated; local = GoView login page
VITE_AUTH_MODE = 'sso'
VITE_AI_SOC_URL = 'http://localhost:3000'

